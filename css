/* General */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #1e293b;
    background: #f8fafc;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}


/* Navigation */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: #2563eb;
}

nav {
    display: flex;
    gap: 30px;
    align-items: center;
}

nav a {
    color: #334155;
}

nav a:hover {
    color: #2563eb;
}


/* Hero */
.hero {
    min-height: 70vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 60px 20px;
    background: #eff6ff;
}

.hero-content {
    max-width: 750px;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 20px;
    color: #0f172a;
}

.hero p {
    font-size: 18px;
    color: #64748b;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    padding: 12px 28px;
    background: #2563eb;
    color: white;
    border-radius: 6px;
    font-weight: bold;
}

.btn:hover {
    background: #1d4ed8;
}


/* Features */
#features {
    padding: 70px 8%;
    text-align: center;
    background: white;
}

#features h2,
#about h2 {
    font-size: 32px;
    margin-bottom: 40px;
}

.features {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

.features div {
    width: 280px;
    padding: 30px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

.features h3 {
    margin-bottom: 10px;
    color: #2563eb;
}

.features p {
    color: #64748b;
}


/* About */
#about {
    padding: 70px 20%;
    text-align: center;
}

#about p {
    color: #64748b;
    max-width: 700px;
    margin: auto;
}


/* Footer */
footer {
    text-align: center;
    padding: 25px;
    background: #0f172a;
    color: white;
}


/* Login Page */
.login-container {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #eff6ff;
    padding: 20px;
}

.login-box {
    width: 100%;
    max-width: 400px;
    padding: 40px;
    background: white;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

.login-box h1 {
    text-align: center;
    color: #2563eb;
    margin-bottom: 5px;
}

.login-box > p {
    text-align: center;
    color: #64748b;
    font-size: 14px;
    margin-bottom: 30px;
}

.login-box h2 {
    margin-bottom: 20px;
}

.login-box label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

.login-box input {
    width: 100%;
    padding: 12px;
    margin-bottom: 18px;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    font-size: 15px;
}

.login-box input:focus {
    outline: none;
    border-color: #2563eb;
}

.login-box button {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 5px;
    background: #2563eb;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

.login-box button:hover {
    background: #1d4ed8;
}

.login-box > a {
    display: block;
    text-align: center;
    margin-top: 20px;
    color: #2563eb;
}


/* Mobile */
@media (max-width: 700px) {

    header {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero h1 {
        font-size: 36px;
    }

    #about {
        padding: 60px 8%;
    }
}